<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FameAI - المساعد الذكي</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<style>
  :root {
    --primary: #8e24aa;
    --primary-dark: #6a1b9a;
    --primary-light: #f3e5f5;
    --bg: #f0f2f5;
    --white: #ffffff;
    --border: #e0e0e0;
    --shadow: 0 2px 8px rgba(0,0,0,0.08);
    --user-bg: #8e24aa;
    --bot-bg: #ffffff;
    --text-main: #1a1a2e;
    --text-secondary: #666;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Tajawal', sans-serif; }

  body {
    background: var(--bg);
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ===== HEADER ===== */
  .header {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    z-index: 10;
    flex-shrink: 0;
  }

  .header-left { display: flex; align-items: center; gap: 12px; }

  .avatar {
    width: 42px; height: 42px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .header-title { font-size: 1rem; font-weight: 700; }

  .status {
    font-size: 0.75rem;
    opacity: 0.85;
    display: flex; align-items: center; gap: 5px;
    margin-top: 2px;
  }

  .dot-online {
    width: 7px; height: 7px;
    background: #4caf50;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* ===== CHAT AREA ===== */
  .chat-area {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-behavior: smooth;
  }

  .chat-area::-webkit-scrollbar { width: 4px; }
  .chat-area::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }

  /* ===== MESSAGES ===== */
  .msg-wrap {
    display: flex;
    flex-direction: column;
    max-width: 78%;
    animation: slideUp 0.25s ease;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .msg-wrap.user { align-self: flex-end; align-items: flex-end; }
  .msg-wrap.bot  { align-self: flex-start; align-items: flex-start; }

  .bubble {
    padding: 11px 16px;
    border-radius: 18px;
    font-size: 0.97rem;
    line-height: 1.55;
    word-wrap: break-word;
    box-shadow: var(--shadow);
    white-space: pre-wrap;
  }

  .user .bubble {
    background: var(--user-bg);
    color: #fff;
    border-bottom-left-radius: 5px;
  }

  .bot .bubble {
    background: var(--bot-bg);
    color: var(--text-main);
    border-bottom-right-radius: 5px;
    border: 1px solid var(--border);
  }

  .msg-time {
    font-size: 0.72rem;
    color: var(--text-secondary);
    margin-top: 4px;
    padding: 0 4px;
  }

  /* Message actions (edit/delete) */
  .msg-actions {
    display: flex;
    gap: 6px;
    margin-top: 4px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .msg-wrap:hover .msg-actions { opacity: 1; }

  @media (max-width: 600px) {
    .msg-actions { opacity: 1; }
  }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.78rem;
    color: #999;
    padding: 2px 7px;
    border-radius: 5px;
    transition: all 0.15s;
  }
  .action-btn:hover { background: #eee; color: #444; }
  .action-btn.del:hover { background: #ffebee; color: #c62828; }

  /* Edit input inside bubble */
  .edit-input {
    width: 100%;
    min-width: 180px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.4);
    color: #fff;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: 'Tajawal', sans-serif;
    outline: none;
    resize: none;
  }

  /* ===== TYPING INDICATOR ===== */
  #typing-wrap {
    align-self: flex-start;
    display: none;
    margin-bottom: 4px;
  }

  .typing-bubble {
    background: var(--bot-bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    border-bottom-right-radius: 5px;
    padding: 12px 18px;
    display: flex;
    gap: 5px;
    align-items: center;
    box-shadow: var(--shadow);
  }

  .dot {
    width: 7px; height: 7px;
    background: #bbb;
    border-radius: 50%;
    animation: bounce 1.3s infinite ease-in-out both;
  }
  .dot:nth-child(1) { animation-delay: -0.3s; }
  .dot:nth-child(2) { animation-delay: -0.15s; }
  .dot:nth-child(3) { animation-delay: 0s; }

  @keyframes bounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* ===== INPUT AREA ===== */
  .input-area {
    background: var(--white);
    border-top: 1px solid var(--border);
    padding: 12px 16px;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    flex-shrink: 0;
  }

  .input-box {
    flex: 1;
    padding: 11px 18px;
    border-radius: 24px;
    border: 1.5px solid var(--border);
    font-size: 0.97rem;
    font-family: 'Tajawal', sans-serif;
    outline: none;
    resize: none;
    max-height: 120px;
    overflow-y: auto;
    line-height: 1.5;
    transition: border-color 0.2s;
    color: var(--text-main);
  }

  .input-box:focus { border-color: var(--primary); }
  .input-box::placeholder { color: #aaa; }

  .send-btn {
    width: 44px; height: 44px;
    flex-shrink: 0;
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
    transition: background 0.2s, transform 0.1s;
    box-shadow: 0 2px 8px rgba(142,36,170,0.3);
  }

  .send-btn:hover { background: var(--primary-dark); }
  .send-btn:active { transform: scale(0.93); }
  .send-btn:disabled { background: #ccc; box-shadow: none; cursor: not-allowed; }

  /* ===== ERROR TOAST ===== */
  #error-toast {
    display: none;
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    background: #c62828;
    color: #fff;
    padding: 10px 20px;
    border-radius: 20px;
    font-size: 0.88rem;
    z-index: 999;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    animation: fadeInOut 3.5s forwards;
  }

  @keyframes fadeInOut {
    0%   { opacity: 0; transform: translateX(-50%) translateY(6px); }
    15%  { opacity: 1; transform: translateX(-50%) translateY(0); }
    80%  { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <div class="header-left">
    <div class="avatar"><i class="fas fa-robot"></i></div>
    <div>
      <div class="header-title">FameAI — المساعد الذكي</div>
      <div class="status">
        <span class="dot-online"></span>
        <span>متصل الآن</span>
      </div>
    </div>
  </div>
  <i class="fas fa-ellipsis-v" style="opacity:0.7;cursor:pointer;padding:6px;"></i>
</header>

<!-- CHAT MESSAGES -->
<main class="chat-area" id="chatArea">
  <div class="msg-wrap bot">
    <div class="bubble">مرحباً! أنا مساعد FameAI الذكي. كيف يمكنني مساعدتك اليوم؟ 😊</div>
    <div class="msg-time" id="welcome-time"></div>
  </div>
</main>

<!-- TYPING INDICATOR -->
<div id="typing-wrap">
  <div class="typing-bubble">
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
  </div>
</div>

<!-- INPUT -->
<footer class="input-area">
  <textarea
    class="input-box"
    id="msgInput"
    placeholder="اكتب رسالتك هنا..."
    rows="1"
    autocomplete="off"
  ></textarea>
  <button class="send-btn" id="sendBtn" title="إرسال">
    <i class="fas fa-paper-plane"></i>
  </button>
</footer>

<!-- ERROR TOAST -->
<div id="error-toast"></div>

<script>
/* ─────────────────────────────────────────
   CONFIG — غير فقط هذا السطر إذا تغير الـ webhook
   ───────────────────────────────────────── */
const WEBHOOK_URL = 'https://tamim15.app.n8n.cloud/webhook/ebe76ea3-2050-4cfd-b6c6-767ca2c02893';

/* ─────────────────────────────────────────
   SESSION ID  (يتذكر المحادثة بين الصفحات)
   ───────────────────────────────────────── */
let sessionId = localStorage.getItem('fameai_session');
if (!sessionId) {
  sessionId = 'sess_' + Math.random().toString(36).slice(2, 11);
  localStorage.setItem('fameai_session', sessionId);
}

/* ─────────────────────────────────────────
   DOM REFS
   ───────────────────────────────────────── */
const chatArea    = document.getElementById('chatArea');
const msgInput    = document.getElementById('msgInput');
const sendBtn     = document.getElementById('sendBtn');
const typingWrap  = document.getElementById('typing-wrap');
const errorToast  = document.getElementById('error-toast');

// وقت الترحيب
document.getElementById('welcome-time').textContent = getTime();

/* ─────────────────────────────────────────
   HELPERS
   ───────────────────────────────────────── */
function getTime() {
  return new Date().toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit' });
}

function scrollDown() {
  chatArea.scrollTop = chatArea.scrollHeight;
}

function setTyping(show) {
  typingWrap.style.display = show ? 'block' : 'none';
  if (show) chatArea.appendChild(typingWrap);
  scrollDown();
}

function showError(msg) {
  errorToast.textContent = msg;
  errorToast.style.display = 'block';
  setTimeout(() => { errorToast.style.display = 'none'; }, 3500);
}

/* ─────────────────────────────────────────
   ADD MESSAGE TO UI
   ───────────────────────────────────────── */
function addMessage(text, sender) {
  const id    = Date.now().toString(36);
  const wrap  = document.createElement('div');
  wrap.className = `msg-wrap ${sender}`;
  wrap.id = `msg-${id}`;

  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  bubble.textContent = text;
  wrap.appendChild(bubble);

  const timeEl = document.createElement('div');
  timeEl.className = 'msg-time';
  timeEl.textContent = getTime();
  wrap.appendChild(timeEl);

  // أزرار التعديل والحذف — فقط لرسائل المستخدم
  if (sender === 'user') {
    const actions = document.createElement('div');
    actions.className = 'msg-actions';

    const editBtn = document.createElement('button');
    editBtn.className = 'action-btn';
    editBtn.innerHTML = '<i class="fas fa-pen"></i> تعديل';
    editBtn.onclick = () => startEdit(id, bubble);

    const delBtn = document.createElement('button');
    delBtn.className = 'action-btn del';
    delBtn.innerHTML = '<i class="fas fa-trash"></i> حذف';
    delBtn.onclick = () => deleteMsg(id);

    actions.appendChild(editBtn);
    actions.appendChild(delBtn);
    wrap.appendChild(actions);
  }

  chatArea.appendChild(wrap);
  scrollDown();
  return id;
}

/* ─────────────────────────────────────────
   EDIT / DELETE
   ───────────────────────────────────────── */
function startEdit(id, bubble) {
  const original = bubble.textContent;
  const input = document.createElement('textarea');
  input.className = 'edit-input';
  input.value = original;
  input.rows = Math.max(1, original.split('\n').length);
  bubble.textContent = '';
  bubble.appendChild(input);
  input.focus();

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      const newText = input.value.trim();
      if (newText) {
        bubble.textContent = newText;
      } else {
        bubble.textContent = original;
      }
    }
    if (e.key === 'Escape') {
      bubble.textContent = original;
    }
  });

  input.addEventListener('blur', () => {
    if (bubble.contains(input)) {
      bubble.textContent = input.value.trim() || original;
    }
  });
}

function deleteMsg(id) {
  const el = document.getElementById(`msg-${id}`);
  if (el) {
    el.style.opacity = '0';
    el.style.transition = 'opacity 0.25s';
    setTimeout(() => el.remove(), 250);
  }
}

/* ─────────────────────────────────────────
   SEND MESSAGE — الدالة الرئيسية
   ───────────────────────────────────────── */
async function handleSend() {
  const text = msgInput.value.trim();
  if (!text || sendBtn.disabled) return;

  // أضف رسالة المستخدم
  addMessage(text, 'user');
  msgInput.value = '';
  msgInput.style.height = 'auto';

  // عطّل الإرسال وأظهر الكتابة
  sendBtn.disabled = true;
  setTyping(true);

  try {
    const res = await fetch(WEBHOOK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chatInput: text,   // ← هذا يطابق $json.body.chatInput في n8n
        sessionId: sessionId
      })
    });

    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    // نقرأ الرد كنص أولاً
    const rawText = await res.text();

    let reply = '';
    try {
      // نحاول نفكك الـ JSON
      const data = JSON.parse(rawText);
      reply = data.output || data.reply || data.text || data.message || rawText;
    } catch {
      // إذا مو JSON، نستخدم النص مباشرة
      reply = rawText;
    }

    if (!reply || reply.trim() === '') {
      reply = 'عذراً، لم أستطع معالجة الرد.';
    }

    setTyping(false);
    addMessage(reply, 'bot');

  } catch (err) {
    console.error('Webhook error:', err);
    setTyping(false);

    let errMsg = 'حدث خطأ في الاتصال بالخادم.';
    if (err.message.includes('Failed to fetch')) {
      errMsg = 'تعذّر الاتصال. تحقق من أن الـ webhook يعمل في n8n.';
    } else if (err.message.includes('HTTP 4')) {
      errMsg = 'الـ webhook غير متاح. تأكد من تفعيله في n8n.';
    }

    showError(errMsg);
    addMessage(errMsg, 'bot');
  } finally {
    sendBtn.disabled = false;
    msgInput.focus();
  }
}

/* ─────────────────────────────────────────
   EVENT LISTENERS
   ───────────────────────────────────────── */
sendBtn.addEventListener('click', handleSend);

msgInput.addEventListener('keydown', (e) => {
  // Enter = إرسال / Shift+Enter = سطر جديد
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    handleSend();
  }
});

// Auto-resize textarea
msgInput.addEventListener('input', () => {
  msgInput.style.height = 'auto';
  msgInput.style.height = Math.min(msgInput.scrollHeight, 120) + 'px';
});
</script>
</body>
</html>
